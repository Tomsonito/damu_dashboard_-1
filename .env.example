# Пример файла окружения. Скопируйте в .env и впишите свои значения:
#   cp .env.example .env
#
# Сам .env в .gitignore и в git НЕ попадает — там боевой пароль от БД.
# На сервере держать с правами 600 (доступ только служебному пользователю):
#   chmod 600 .env

# --- Обязательное ---

# Строка подключения к боевой БД. Формат для PostgreSQL:
#   postgresql+psycopg2://пользователь:пароль@хост:порт/база
# !! Пользователь БД — только на чтение и только к нужным таблицам
# (пункт 1 чек-листа безопасности): даже при ошибке в коде сайт физически
# не сможет изменить данные компании.
DATABASE_URL=postgresql+psycopg2://<пользователь>:<пароль>@<хост>:5432/<база>

# --- Необязательное ---

# Включить отладчик Werkzeug (=1). НА СЕРВЕРЕ НЕ ЗАДАВАТЬ: отладчик даёт
# интерактивную Python-консоль в браузере при ошибке. Только для локальной
# разработки. По умолчанию выключен.
# DASHBOARD_DEBUG=1

# Папка файлового кэша. По умолчанию data/cache/. Переопределять, только
# если нужно вынести кэш на быстрый диск (например tmpfs).
# DASHBOARD_CACHE_DIR=/dev/shm/damu-cache

# Потолок объёма файлового кэша, мегабайты. По умолчанию 150 — умеренно,
# вырастут данные, поднять здесь же (core/cache.py, sweep()).
# DASHBOARD_CACHE_LIMIT_MB=150

# Ошибки прогона ETL — в Sentry (пока подключено ТОЛЬКО к etl/run.py,
# не к сайту: см. core/monitoring.py, там разбор «почему только ETL»).
# Пусто — Sentry молчит, это рабочий сценарий локальной разработки.
# DSN получить в кабинете Sentry: Settings -> Projects -> нужный проект -> Client Keys.
# SENTRY_DSN=https://<ключ>@<организация>.ingest.<регион>.sentry.io/<id проекта>

# Метка окружения в Sentry — отличать боевые ошибки от локальных прогонов.
# По умолчанию "development". На сервере (этап 5) поставить "production".
# DASHBOARD_ENV=production
